---
import { SITE } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/services". Defaults to current path. */
  path?: string;
  /** Set false on the thank-you page so it is not indexed. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
// Normalize to a trailing slash so canonicals match the directory-style URLs
// the CDN serves (and the trailing-slash form in sitemap-0.xml).
const rawPath = path ?? Astro.url.pathname;
const normalizedPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonical = new URL(normalizedPath, SITE.url).href;

// ── HomeAndConstructionBusiness JSON-LD ──────────────────────────────────────
// Strict local schema. areaServed locks to American Fork, Utah (ZIP 84003).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE.url}/#business`,
  name: SITE.businessName,
  legalName: SITE.legalName,
  url: SITE.url,
  telephone: SITE.phone.raw,
  priceRange: SITE.priceRange,
  description,
  image: `${SITE.url}/og-image.svg`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.state,
    postalCode: SITE.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng,
  },
  areaServed: {
    '@type': 'City',
    name: `${SITE.city}, ${SITE.stateLong}`,
    '@id': 'https://www.wikidata.org/wiki/Q749477',
  },
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: SITE.geo.lat,
      longitude: SITE.geo.lng,
    },
    geoRadius: 16000,
  },
  openingHours: SITE.hours,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '127',
  },
  makesOffer: [
    'Junk Removal',
    'Appliance Removal',
    'Furniture Removal',
    'Yard Waste Hauling',
    'Construction Debris Removal',
  ].map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#16803c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (kept minimal) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />

    <meta name="geo.region" content="US-UT" />
    <meta name="geo.placename" content={`${SITE.city}, ${SITE.stateLong}`} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCallBar />
  </body>
</html>
