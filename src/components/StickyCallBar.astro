---
import { SITE } from '../config/site';
---

<!-- Mobile-only sticky "Tap to Call" bar, anchored to the bottom of the screen.
     Hidden on desktop (>=860px) where the header call button is always visible. -->
<a class="sticky-call" href={SITE.phone.tel} data-call="sticky" aria-label={`Tap to call ${SITE.businessName} at ${SITE.phone.display}`}>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.5.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.57 3.5a1 1 0 0 1-.24 1l-2.23 2.3Z"/></svg>
  <span><strong>Tap to Call</strong> · {SITE.phone.display}</span>
</a>

<style>
  .sticky-call {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    height: var(--sticky-h);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--orange);
    color: #fff;
    text-decoration: none;
    font-size: 1.12rem;
    font-weight: 700;
    box-shadow: 0 -6px 20px rgba(20, 33, 27, 0.18);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .sticky-call strong { font-weight: 900; }
  .sticky-call svg { width: 24px; height: 24px; }

  @media (min-width: 860px) {
    .sticky-call { display: none; }
  }
</style>
