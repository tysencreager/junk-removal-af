---
import { Image } from 'astro:assets';
import { SITE } from '../config/site';
import logo from '../assets/junkremoval-logo.png';
---

<header class="hdr">
  <div class="container hdr__inner">
    <a href="/" class="brand" aria-label={`${SITE.businessName} home`}>
      <Image
        src={logo}
        alt={`${SITE.businessName} logo`}
        class="brand__img"
        width={130}
        height={100}
        format="webp"
        quality={85}
        loading="eager"
      />
      <span class="brand__text">
        <strong>{SITE.brand.line1}</strong>
        <span>{SITE.brand.line2}</span>
      </span>
    </a>

    <a href={SITE.phone.tel} class="hdr__call" data-call="header">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.5.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.57 3.5a1 1 0 0 1-.24 1l-2.23 2.3Z"/></svg>
      <span class="hdr__call-text">
        <span class="hdr__call-label">Call Now</span>
        <span class="hdr__call-num">{SITE.phone.display}</span>
      </span>
    </a>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  .brand__img {
    height: 50px;
    width: auto;
    display: block;
  }
  .brand__text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand__text strong { font-size: 1.02rem; }
  .brand__text span { font-size: 0.82rem; color: var(--slate); }

  .hdr__call {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--orange);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    padding: 10px 16px;
    border-radius: 10px;
  }
  .hdr__call svg { width: 20px; height: 20px; }
  .hdr__call-text { display: flex; flex-direction: column; line-height: 1.1; }
  .hdr__call-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.9; }
  .hdr__call-num { font-size: 1.05rem; }

  /* On small screens the header call button shows only "Call" to save room;
     the full number is always one tap away in the hero + sticky bar. */
  @media (max-width: 519px) {
    .hdr__call-text { display: none; }
    .hdr__call { padding: 10px 12px; }
    .hdr__call::after { content: "Call"; font-size: 0.95rem; }
  }
</style>
