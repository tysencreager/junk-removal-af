---
import { SITE } from '../config/site';

export interface Props {
  heading?: string;
  sub?: string;
}

const {
  heading = `Ready to Get That Junk Gone in ${SITE.city}?`,
  sub = 'Call now for a free quote and same-day service, or send a few details and we’ll call you right back.',
} = Astro.props;
---

<section class="section section--ink cta" aria-labelledby="cta-h">
  <div class="container cta__inner">
    <div>
      <span class="eyebrow">Free Estimate · No Obligation</span>
      <h2 id="cta-h">{heading}</h2>
      <p class="lede">{sub}</p>
    </div>
    <div class="cta__actions">
      <a href={SITE.phone.tel} class="btn btn--call" data-call="cta">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.5.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.57 3.5a1 1 0 0 1-.24 1l-2.23 2.3Z"/></svg>
        Call {SITE.phone.display}
      </a>
      <a href="/contact" class="btn btn--ghost">Request a Quote Online</a>
    </div>
  </div>
</section>

<style>
  .cta__inner { display: grid; gap: 26px; }
  @media (min-width: 860px) {
    .cta__inner { grid-template-columns: 1.2fr 0.8fr; align-items: center; }
  }
  .cta__actions { display: flex; flex-direction: column; gap: 12px; }
  @media (min-width: 480px) and (max-width: 859px) {
    .cta__actions { flex-direction: row; }
  }
</style>
