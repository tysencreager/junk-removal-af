---
import { SITE } from '../config/site';
---

<section class="section" aria-labelledby="areas-h">
  <div class="container">
    <span class="eyebrow">Areas Served</span>
    <h2 id="areas-h">
      {SITE.scope === 'state'
        ? `Junk Removal Across ${SITE.stateLong}`
        : `Junk Removal Across ${SITE.regionShort} ${SITE.nearbyLabel}`}
    </h2>
    <p class="lede">
      {SITE.scope === 'state'
        ? `We haul junk in cities across ${SITE.stateLong}. From the Wasatch Front to southern Utah, if you’re in our service area we can usually be there the same day.`
        : `We haul junk throughout ${SITE.region} (${SITE.zip}) and the surrounding neighborhoods. If you’re close by, we can usually be there the same day.`}
    </p>

    <ul class="areas">
      {SITE.areasServed.map((a) => (
        <li>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
          {a}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .areas {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 18px;
  }
  @media (min-width: 720px) { .areas { grid-template-columns: repeat(3, 1fr); } }
  .areas li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--slate);
    font-weight: 600;
  }
  .areas li svg { width: 18px; height: 18px; color: var(--green); flex: none; }
</style>
