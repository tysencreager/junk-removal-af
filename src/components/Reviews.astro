---
import { SITE } from '../config/site';

// NOTE: Placeholder reviews for layout/demo. Replace with real, verifiable
// customer reviews before running paid traffic or to stay compliant.
const reviews = [
  {
    name: 'Jared M.',
    area: 'Shadow Valley, American Fork',
    text: 'Booked in the morning, gone by afternoon. They hauled an old fridge and a couch out of my basement without a scratch on the walls. Fair price, no surprises.',
  },
  {
    name: 'Brittany S.',
    area: 'The Highlands, American Fork',
    text: 'We did a full garage cleanout and they took everything — old furniture, paint cans, yard waste. Friendly crew and same-day service. Highly recommend.',
  },
  {
    name: 'Devin R.',
    area: 'Downtown American Fork',
    text: 'Called for construction debris after a bathroom remodel. Quick quote over the phone, showed up on time, and the price matched exactly. Will use again.',
  },
];
---

<section class="section section--mist" aria-labelledby="reviews-h">
  <div class="container">
    <span class="eyebrow">What Your American Fork Neighbors Say</span>
    <h2 id="reviews-h">Trusted Junk Removal in {SITE.city}, {SITE.stateLong}</h2>
    <p class="lede">Rated 4.9 out of 5 across 127+ local hauling jobs.</p>

    <div class="grid grid--3" style="margin-top: 26px;">
      {reviews.map((r) => (
        <figure class="card review">
          <div class="review__stars" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote>{r.text}</blockquote>
          <figcaption>
            <strong>{r.name}</strong>
            <span>{r.area}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .review { display: flex; flex-direction: column; gap: 10px; margin: 0; }
  .review__stars { color: var(--gold); letter-spacing: 2px; font-size: 1.05rem; }
  .review blockquote { margin: 0; color: var(--ink); }
  .review figcaption { display: flex; flex-direction: column; line-height: 1.2; margin-top: auto; }
  .review figcaption strong { color: var(--ink); }
  .review figcaption span { color: var(--slate); font-size: 0.88rem; }
</style>
