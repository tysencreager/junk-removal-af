---
import { SITE } from '../config/site';

export interface Props {
  heading?: string;
  intro?: string;
}

const {
  heading = 'What We Take',
  intro = `From a single appliance to a whole-house cleanout, our ${SITE.regionShort} crew hauls away just about anything non-hazardous. Common jobs include:`,
} = Astro.props;

const current = Astro.url.pathname;
const region = SITE.regionShort;

// Each category renders as an H3 (per required heading structure).
const items = [
  {
    h3: 'Appliances',
    body: 'Refrigerators, washers, dryers, dishwashers, stoves, and water heaters.',
    path: 'M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2 3v3h8V6H8Zm0 5v6h8v-6H8Z',
    href: '/appliance-removal',
  },
  {
    h3: 'Furniture',
    body: 'Couches, sectionals, mattresses, dressers, tables, and office furniture.',
    path: 'M4 10a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v1a2 2 0 0 0-2 2v2H6v-2a2 2 0 0 0-2-2v-1Zm-1 5h18v3h-2v-1H5v1H3v-3Z',
    href: '/furniture-removal',
  },
  {
    h3: 'Yard Waste',
    body: 'Branches, leaves, soil, sod, fencing, and seasonal landscaping debris.',
    path: 'M12 2c3 3 5 6 5 9a5 5 0 0 1-4 4.9V22h-2v-6.1A5 5 0 0 1 7 11c0-3 2-6 5-9Z',
  },
  {
    h3: 'Construction Debris',
    body: 'Drywall, lumber, flooring, tile, and post-remodel renovation waste.',
    path: 'M3 21V8l9-5 9 5v13h-6v-7H9v7H3Z',
  },
  {
    h3: 'Electronics & E-Waste',
    body: 'TVs, monitors, computers, printers, and other old electronics.',
    path: 'M3 4h18v12H3V4Zm0 14h18v2H3v-2Zm6-2h6v-1H9v1Z',
  },
  {
    h3: 'Garage & Estate Cleanouts',
    body: 'Full garage, basement, storage unit, and estate cleanout hauling.',
    path: 'M12 3 3 8v13h18V8l-9-5Zm-5 8h10v8H7v-8Zm2 2v4h6v-4H9Z',
  },
];
---

<section class="section section--mist" aria-labelledby="take-h">
  <div class="container">
    <span class="eyebrow">Junk &amp; Debris Removal</span>
    <h2 id="take-h">{heading}</h2>
    <p class="lede">{intro}</p>

    <div class="grid grid--3" style="margin-top: 26px;">
      {items.map((it) => {
        // Link the card to its dedicated service page, but never self-link.
        const linkable = it.href && !current.startsWith(it.href);
        const Tag = linkable ? 'a' : 'div';
        return (
          <Tag class:list={['card', { 'card--link': linkable }]} href={linkable ? it.href : undefined}>
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d={it.path} /></svg>
            </span>
            <h3>{it.h3}</h3>
            <p>{it.body}</p>
            {linkable && <span class="card__more">{it.h3} removal in {region} →</span>}
          </Tag>
        );
      })}
    </div>

    <p class="take__note">
      Not sure if we take it? Just ask — if it’s not hazardous waste, we probably haul it.
    </p>
  </div>
</section>

<style>
  a.card--link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.06s ease;
  }
  a.card--link:hover {
    border-color: var(--green);
    box-shadow: var(--shadow);
  }
  a.card--link:active { transform: translateY(1px); }
  .card__more {
    display: inline-block;
    margin-top: 12px;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--green-dark);
  }
  .take__note {
    margin-top: 22px;
    color: var(--slate);
    font-weight: 600;
  }
</style>
