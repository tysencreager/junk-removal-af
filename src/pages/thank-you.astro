---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';

const title = 'Thank You | American Fork Junk Removal';
const description = 'Thanks — your junk removal request was received. We’ll reach out shortly.';
---

<Layout title={title} description={description} path="/thank-you" noindex={true}>
  <!--
    CONVERSION TRACKING:
    Fire your conversion pixels here (Google Ads, GA4, Meta, etc.).
    This page loads only after a successful form submission, so a pageview /
    event on /thank-you = one captured lead. Add tags in the block below.
  -->

  <section class="ty">
    <div class="container ty__inner">
      <span class="ty__check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
      </span>
      <h1>Thank You — Request Received!</h1>
      <p class="lede">
        Thanks for reaching out to {SITE.businessName}. A team member will contact you
        shortly to confirm your free quote and schedule your {SITE.city} pickup.
      </p>

      <p class="ty__rush">Need it gone right now? Call us and we’ll get moving:</p>
      <a href={SITE.phone.tel} class="btn btn--call ty__call" data-call="thankyou">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.5.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.57 3.5a1 1 0 0 1-.24 1l-2.23 2.3Z"/></svg>
        Call {SITE.phone.display}
      </a>

      <p class="ty__back"><a href="/">← Back to home</a></p>
    </div>
  </section>

  <!-- Example conversion tag placeholder — replace with your real pixel(s):
  <script>
    // gtag('event', 'conversion', { send_to: 'AW-XXXXXXXXX/XXXXXXXX' });
  </script>
  -->
</Layout>

<style>
  .ty { padding: 70px 0; background: linear-gradient(180deg, #f7faf8, #fff); }
  .ty__inner { max-width: 640px; margin: 0 auto; text-align: center; }
  .ty__check {
    display: inline-grid; place-items: center;
    width: 76px; height: 76px;
    background: var(--green); color: #fff;
    border-radius: 50%;
    margin-bottom: 18px;
  }
  .ty__check svg { width: 44px; height: 44px; }
  .ty__rush { font-weight: 700; margin-top: 22px; }
  .ty__call { font-size: 1.18rem; }
  .ty__back { margin-top: 26px; }
  .ty__back a { color: var(--slate); text-decoration: none; }
</style>
