---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustBadges from '../components/TrustBadges.astro';
import AreasServed from '../components/AreasServed.astro';
import { SITE } from '../config/site';

const title = 'Junk Removal Quote American Fork UT | Free Same-Day Estimate';
const description =
  'Get a free junk removal quote in American Fork, Utah. Call now or send a few details and we’ll reply fast with upfront pricing and same-day pickup. No obligation!';
---

<Layout title={title} description={description} path="/contact">
  <section class="hero hero--contact">
    <div class="container quote">
      <div class="quote__copy">
        <span class="eyebrow hero__eyebrow">Free Estimate · No Obligation</span>
        <h1>Get Your Free Junk Removal Quote in American Fork, UT</h1>
        <p class="lede">
          Tell us what you need hauled and we’ll get right back to you with an upfront price.
          Prefer to talk? Call now — we answer 7 days a week.
        </p>

        <a href={SITE.phone.tel} class="btn btn--call quote__call" data-call="contact-hero">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.5.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.57 3.5a1 1 0 0 1-.24 1l-2.23 2.3Z"/></svg>
          Call {SITE.phone.display}
        </a>

        <ul class="checks quote__list">
          <li>Free, no-obligation quotes</li>
          <li>Same-day &amp; next-day pickup</li>
          <li>Upfront, all-inclusive pricing</li>
          <li>Serving {SITE.city}, {SITE.stateLong} {SITE.zip} &amp; nearby</li>
        </ul>

        <p class="quote__hours">Open 7 days a week · 6:00am – 9:00pm</p>
      </div>

      <div class="quote__form" id="quote">
        <LeadForm
          heading="Request a Free Quote"
          sub="4 quick fields. We’ll reply fast with your price."
          id="contact"
          source="contact-page"
        />
      </div>
    </div>
  </section>

  <TrustBadges />
  <AreasServed />
</Layout>

<style>
  .hero--contact {
    background:
      radial-gradient(1000px 400px at 80% -10%, rgba(22, 128, 60, 0.16), transparent 60%),
      linear-gradient(180deg, #f7faf8 0%, #ffffff 100%);
  }
  .quote {
    display: grid;
    gap: 30px;
    padding: 40px 20px 52px;
  }
  @media (min-width: 920px) {
    .quote { grid-template-columns: 1fr 0.9fr; gap: 48px; padding: 60px 20px 72px; }
  }
  .quote__call { margin: 6px 0 20px; font-size: 1.15rem; }
  .quote__list { display: grid; gap: 2px; }
  @media (min-width: 560px) { .quote__list { grid-template-columns: 1fr 1fr; } }
  .quote__hours { margin-top: 16px; font-weight: 700; color: var(--slate); }
</style>
