---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import WhatWeTake from '../components/WhatWeTake.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Reviews from '../components/Reviews.astro';
import AreasServed from '../components/AreasServed.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config/site';

const c = SITE.content.home;
---

<Layout title={c.title} description={c.description} path="/" faq={c.faqs}>
  <Hero h1={c.h1} lede={c.lede} />

  <TrustBadges />

  <!-- H2: What We Take (Appliances, Furniture, Yard Waste) -->
  <WhatWeTake />

  <!-- H2: How Our [Region] Hauling Process Works -->
  <ProcessSteps />

  <Reviews />

  <AreasServed />

  <Faq heading={c.faqHeading} items={c.faqs} />

  <CtaBand />
</Layout>
